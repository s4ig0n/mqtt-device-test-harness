{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Thermostat telemetry",
  "type": "object",
  "required": ["device_id", "seq", "ts", "temperature_c", "humidity_pct", "setpoint_c", "heater_on", "fault"],
  "additionalProperties": false,
  "properties": {
    "device_id": {"type": "string", "minLength": 1},
    "seq": {"type": "integer", "minimum": 0},
    "ts": {"type": "number"},
    "temperature_c": {"type": ["number", "null"], "minimum": -40, "maximum": 85},
    "humidity_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "setpoint_c": {"type": "number", "minimum": 5, "maximum": 35},
    "heater_on": {"type": "boolean"},
    "fault": {"type": ["string", "null"]}
  }
}
